# DhakaScenes Pilot — environment contract (template)
#
#   cp .env.example .env      then fill the SECRET block
#
# .env is git-ignored. .env.example is committed and is the CANONICAL LIST of
# every variable this project reads. The rule, enforced by tests/unit/test_env_contract.py
# (PHASE-2-PENDING): every os.environ / os.getenv key anywhere in pipeline/, scripts/,
# probes/ or tests/ must appear here, and every key here must be read somewhere.
# An undeclared env var is a hidden config value, and pilot_plan.md §10 requires
# every tunable to be config with a provenance note.
#
# WHAT BELONGS HERE vs IN configs/
#   .env      = machine-local facts and secrets. Differ per machine. Never in a manifest.
#   configs/  = experiment parameters. Identical across machines. Recorded in every
#               run_manifest.json (§1.9). Seeds, thresholds, windows, taxonomy → configs/.
#   If changing a value would change the OUTPUT, it is configs/, not .env.

# ===========================================================================
# SECRETS — never commit real values
# ===========================================================================

# Hugging Face access token. facebook/dinov2-small and IDEA-Research/grounding-dino-tiny
# are ungated as of 2026-08-12, so this is only needed for rate-limit headroom and for
# the models_production.yaml tier (§7.3) if a gated checkpoint is ever selected.
# UPDATE (C19/C26): two gated repos are now in play — facebook/sam3 (mask_2d
# default) and facebook/sam3.1 (sam31_multiplex provider, checkpoint
# sam3.1_multiplex.pt). Both grants are held by the project account; the token
# is required on first download of either.
HF_TOKEN=

# CVAT review server — WRITE credentials. Read by scripts/cvat_setup.py,
# scripts/cvat_setup_3d.py, scripts/import_cvat_3d.py and scripts/cvat_purge.py
# (all via `cvat_sdk.make_client`), and therefore by the `cvat` / `cvat3d` steps of
# scripts/run_stages.sh's default chain. This account CREATES projects and tasks and,
# under --cvat-replace / --clean-slate, DELETES them; it is not a read-only viewer
# login, so an empty CVAT_PASSWORD fails the publish rather than degrading to a
# browse. CVAT_HOST is a machine-local fact: the server answers on
# `http://localhost:8081` on the box itself and on its tailnet address from anywhere
# else (docs/CVAT_GUIDE.md). Leave all three blank here — .env is git-ignored,
# .env.example is committed.
CVAT_HOST=
CVAT_USER=
CVAT_PASSWORD=

# ===========================================================================
# CHECKPOINT AND CACHE LOCATIONS
# §1.8: nothing large lands inside the repo tree. These roots are siblings of
# work_root/out_root in configs/paths.yaml, not children of the project.
# ===========================================================================

HF_HOME=/home/mt/dhakascenes/cache/huggingface
HUGGINGFACE_HUB_CACHE=/home/mt/dhakascenes/cache/huggingface/hub
TORCH_HOME=/home/mt/dhakascenes/cache/torch

# MobileSAM ships weights as a FILE, not a hub id (pipeline/stage4_masks/masks.py
# raises ModelUnavailable with exactly this message if it is unset or not a file).
# Source: https://github.com/ChaoningZhang/MobileSAM  weights/mobile_sam.pt
MOBILE_SAM_CHECKPOINT=/home/mt/dhakascenes/cache/checkpoints/mobile_sam.pt

# YOLO11x — the Stage 3 proposal_2d default since 2026-08-14. Also a FILE, not a
# hub id: `YOLO("yolo11x.pt")` on a missing file downloads into the CWD, i.e.
# into the repo tree (§1.8), so the adapter refuses anything that is not an
# existing path and names this variable.
# Source: https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11x.pt
#   sha256 7bc158aa95c0ebfdd87f70f01653c1131b93e92522dbe15c228bcd742e773a24
YOLO11_CHECKPOINT=/home/mt/dhakascenes/cache/checkpoints/yolo11x.pt

# ultralytics writes a settings.json at import time; unset, it lands in
# $HOME/.config/Ultralytics and warns on every run. Nothing reads it back.
YOLO_CONFIG_DIR=/home/mt/dhakascenes/cache/ultralytics

# ===========================================================================
# INTERPRETER ISOLATION — non-negotiable, and it has already bitten once
#
# The ano_pipe env is Python 3.10, and so is this machine's system interpreter.
# That means `/home/mt/.local/lib/python3.10/site-packages` lands on sys.path
# AHEAD of the env's own site-packages: a user-site package silently shadows the
# pinned one, and `pip install` into the env will UNINSTALL the shadowing copy
# from ~/.local as a side effect. Both happened here on 2026-08-12.
#
# Consequences if this is unset: run_manifest.json (§1.9) records the pinned
# version while the interpreter imported a different one, and the determinism
# test (§1.9, byte-compare) can pass on one shell and fail on another.
# ===========================================================================

PYTHONNOUSERSITE=1

# ===========================================================================
# PATH CONTRACT (§1.8)
# The YAML remains the source of truth. This only says WHICH yaml, so a second
# substrate can be pointed at without editing a tracked file.
# ===========================================================================

DHAKASCENES_PATHS_CONFIG=configs/paths.yaml

# ===========================================================================
# DETERMINISM (§1.9)
# The global SEED is NOT here — it lives in configs/pipeline_pilot.yaml because it
# changes output and must appear in run_manifest.json. These four only remove
# nondeterminism that has no config meaning.
# ===========================================================================

# Required by torch.use_deterministic_algorithms(True) for cuBLAS GEMMs.
# Without it, deterministic mode raises at the first matmul.
CUBLAS_WORKSPACE_CONFIG=:4096:8

# §1.9 names cuDNN autotuning and TF32 as sources of run-to-run numeric drift.
# 0 = off. Turning either on invalidates the byte-compare determinism test.
DHAKASCENES_ALLOW_TF32=0
DHAKASCENES_CUDNN_BENCHMARK=0

# HF tokenizers fork a thread pool; the warning is harmless but the nondeterministic
# thread count is not, and Stage 3's phrase-span bookkeeping runs inside it.
TOKENIZERS_PARALLELISM=false

# ===========================================================================
# GPU AND MEMORY (§Phase 5b)
# ===========================================================================

CUDA_VISIBLE_DEVICES=0

# Mandated by Phase 5b, verbatim: "Set PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# given the variable-length text tensors."
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Synthetic VRAM ceiling in MiB — C1, RESOLVED BY HUMAN 2026-08-12 (docs/BUILD_PROMPT.md §5),
# amended by C19, RESOLVED BY HUMAN 2026-08-13 (docs/DECISIONS.md). Enforced at process
# start via torch.cuda.set_per_process_memory_fraction and recorded in every manifest as
# {enforced: "synthetic", physical_device_mib: 24564}. Two values exist:
#   4096  — pilot tier: the 4-GB laptop contract (C1). Still the value for every
#           pilot-tier run; any "runs on 4 GB" claim requires pilot-tier models
#           under THIS cap.
#   22000 — production tier: the default budget on this 24-GB 4090 (C19), headroom
#           left for the display server and other users on a shared card.
# On the 3050ti laptop itself, set this empty (the physical card IS the ceiling).
# An uncapped run on this machine supports no 4 GB claim and must carry verified: false.
DHAKASCENES_VRAM_CAP_MIB=22000

# ===========================================================================
# TEST GATES (§9)
# "Integration tests touch the real chunk and/or the real GPU, opt-in behind an
#  env var so they never silently false-pass against absent data."
# Default 0 everywhere. CI and a fresh clone must not silently skip-and-pass.
# ===========================================================================

DHAKASCENES_RUN_INTEGRATION=0
DHAKASCENES_RUN_GPU_TESTS=0

# The indigenous-prompt probe (§8) is hard-separated by mechanism, not naming.
# It stays off unless deliberately switched on, and it writes only to probe_out_root.
DHAKASCENES_RUN_INDIGENOUS_PROBE=0

# ===========================================================================
# THREADING — determinism and the 32-core host
# umap-learn with random_state forces single-threaded execution anyway (§1.9);
# pinning BLAS threads keeps the rest of the numerics comparable run to run.
# ===========================================================================

OMP_NUM_THREADS=8
MKL_NUM_THREADS=8
